[Unit]
Description=HRMS Portal Enterprise Web Application
After=syslog.target network.target mysql.service

[Service]
Type=simple
User=hrms
Group=hrms
WorkingDirectory=/opt/hrms-portal
Environment="JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64"
Environment="SPRING_PROFILES_ACTIVE=prod"
Environment="PORT=8080"
Environment="DB_URL=jdbc:mysql://localhost:3306/hrms_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
Environment="DB_USERNAME=hrms_user"
Environment="DB_PASSWORD=StrongPasswordHere"
ExecStart=/usr/bin/java -XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -jar /opt/hrms-portal/hrms-portal.jar
SuccessExitStatus=143
TimeoutStopSec=30
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
