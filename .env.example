# ==============================================================================
# HRMS Portal — Environment Variables Template
# Copy this file to .env and adjust values for your deployment
# ==============================================================================

# Application Port
PORT=8080

# Spring Active Profile (prod, h2, dev)
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (MySQL / PostgreSQL / AWS RDS / Cloud DB)
DB_URL=jdbc:mysql://hrms-db:3306/hrms_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=hrms_db

# Production requires a unique initial admin username and a password of at least 16 characters.
# Remove these from the environment after the first successful startup.
HRMS_BOOTSTRAP_ADMIN_USERNAME=
HRMS_BOOTSTRAP_ADMIN_PASSWORD=
DEMO_ACCOUNTS_ENABLED=false

# JVM Memory Tuning (Optional)
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0

# Upload Directory
UPLOAD_DIR=/app/uploads
